Is Sensitive Customer =
VAR ReportingDate =
    MAX('Date selector (reporting)'[Date reporting])

VAR CurrentCustomerKey =
    SELECTEDVALUE('CPS Accounting'[Customer key])

VAR SensitiveCustomer =
    CALCULATE(
        COUNTROWS('Tethys Code'),
        REMOVEFILTERS('Tethys Code'),
        'Tethys Code'[Date effect] = ReportingDate,
        'Tethys Code'[Customer key] = CurrentCustomerKey
    )

RETURN
    IF(
        NOT ISBLANK(CurrentCustomerKey)
            && SensitiveCustomer > 0,
        1,
        0
    )
