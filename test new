Show Date Effect =
VAR ReportingDate =
    SELECTEDVALUE(
        'Date selector (reporting)'[Date reporting]
    )

VAR CurrentDate =
    SELECTEDVALUE(
        'Date selector (date effect)'[Date effet]
    )

VAR StartDate =
    EDATE(ReportingDate, -13)

RETURN
    IF(
        NOT ISBLANK(ReportingDate)
            && NOT ISBLANK(CurrentDate)
            && CurrentDate >= StartDate
            && CurrentDate <= ReportingDate,
        1,
        0
    )
