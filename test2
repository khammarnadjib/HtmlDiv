Nb Rows =
VAR MaxDate =
    MAX('Date selector (reporting)'[Date reporting])

VAR SelectedEffectStart =
    MINX(
        ALLSELECTED('Date selector (date effect)'[Date effet]),
        'Date selector (date effect)'[Date effet]
    )

VAR SelectedEffectEnd =
    MAXX(
        ALLSELECTED('Date selector (date effect)'[Date effet]),
        'Date selector (date effect)'[Date effet]
    )

VAR SensitiveRAFs =
    CALCULATETABLE(
        VALUES('Tethys Code'[Customer RAF Code]),
        REMOVEFILTERS('Tethys Code'),
        REMOVEFILTERS('CPS Accounting'),
        'Tethys Code'[Date effect] = MaxDate
    )

RETURN
    CALCULATE(
        COUNTROWS('CPS Accounting'),
        REMOVEFILTERS('Tethys Code'),
        REMOVEFILTERS('CPS Accounting'[Date effet]),
        FILTER(
            ALL('CPS Accounting'[Date effet]),
            'CPS Accounting'[Date effet] >= SelectedEffectStart
                && 'CPS Accounting'[Date effet] <= SelectedEffectEnd
                && 'CPS Accounting'[Date effet] <= MaxDate
        ),
        KEEPFILTERS(
            TREATAS(
                SensitiveRAFs,
                'CPS Accounting'[Customer RAF]
            )
        )
    )
