Debug Date Period =
VAR ReportingDate =
    SELECTEDVALUE(
        'Date selector (reporting)'[Date reporting]
    )

VAR StartDate =
    EDATE(ReportingDate, -13)

VAR SelectedStart =
    MINX(
        ALLSELECTED(
            'Date selector (date effect)'[Date effet]
        ),
        'Date selector (date effect)'[Date effet]
    )

VAR SelectedEnd =
    MAXX(
        ALLSELECTED(
            'Date selector (date effect)'[Date effet]
        ),
        'Date selector (date effect)'[Date effet]
    )

RETURN
    FORMAT(StartDate, "dd/MM/yyyy")
        & " au "
        & FORMAT(ReportingDate, "dd/MM/yyyy")
        & " | Sélection : "
        & FORMAT(SelectedStart, "dd/MM/yyyy")
        & " au "
        & FORMAT(SelectedEnd, "dd/MM/yyyy")
