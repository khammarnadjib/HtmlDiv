Is In Display Period =
VAR ReportingDate =
    SELECTEDVALUE(
        'Date selector (reporting)'[Date reporting]
    )

VAR DefaultStart =
    EDATE(ReportingDate, -13)

VAR SelectedStart =
    MIN('Date selector (date effect)'[Date effet])

VAR SelectedEnd =
    MAX('Date selector (date effect)'[Date effet])

VAR EffectiveStart =
    MAX(DefaultStart, SelectedStart)

VAR EffectiveEnd =
    MIN(ReportingDate, SelectedEnd)

VAR DatesToApply =
    FILTER(
        ALL('Date selector (date effect)'[Date effet]),
        'Date selector (date effect)'[Date effet]
            >= EffectiveStart
            &&
        'Date selector (date effect)'[Date effet]
            <= EffectiveEnd
    )

VAR MatchingRows =
    CALCULATE(
        COUNTROWS('CPS Accounting'),
        KEEPFILTERS(
            TREATAS(
                DatesToApply,
                'CPS Accounting'[Date effet]
            )
        )
    )

RETURN
    IF(
        NOT ISBLANK(ReportingDate)
            && EffectiveStart <= EffectiveEnd
            && MatchingRows > 0,
        1,
        0
    )
