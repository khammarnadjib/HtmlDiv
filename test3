Show Date Effect =
VAR ReportingDate =
    SELECTEDVALUE(
        'Date selector (reporting)'[Date reporting]
    )

VAR CurrentDate =
    SELECTEDVALUE(
        'Date selector (date effect)'[Date effect]
    )

VAR StartDate =
    EDATE(ReportingDate, -13)

RETURN
    IF(
        NOT ISBLANK(ReportingDate)
            && NOT ISBLANK(CurrentDate)
            && CurrentDate >= StartDate
            && CurrentDate <= ReportingDate,
        1,
        0
    )


Show RAF Transaction =
VAR ReportingDate =
    SELECTEDVALUE(
        'Date selector (reporting)'[Date reporting]
    )

VAR StartDate =
    EDATE(ReportingDate, -13)

VAR TransactionDate =
    SELECTEDVALUE(
        'CPS Accounting'[Date effect]
    )

VAR SelectedDates =
    VALUES(
        'Date selector (date effect)'[Date effect]
    )

VAR IsDateSelected =
    CONTAINS(
        SelectedDates,
        'Date selector (date effect)'[Date effect],
        TransactionDate
    )

RETURN
    IF(
        NOT ISBLANK(ReportingDate)
            && NOT ISBLANK(TransactionDate)
            && TransactionDate >= StartDate
            && TransactionDate <= ReportingDate
            && IsDateSelected,
        1,
        0
    )
