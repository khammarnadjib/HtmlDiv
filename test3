Is In Display Period =
VAR ReportingDate =
    MAX(
        'Date selector (reporting)'[Date reporting]
    )

VAR SelectedStart =
    MIN(
        'Date selector (date effect)'[Date effet]
    )

VAR SelectedEnd =
    MAX(
        'Date selector (date effect)'[Date effet]
    )

VAR DefaultStart =
    EDATE(ReportingDate, -13)

VAR EffectiveStart =
    MAX(DefaultStart, SelectedStart)

VAR EffectiveEnd =
    MIN(ReportingDate, SelectedEnd)

VAR RowDate =
    MAX('CPS Accounting'[Date effet])

RETURN
    IF(
        NOT ISBLANK(ReportingDate)
            && NOT ISBLANK(RowDate)
            && RowDate >= EffectiveStart
            && RowDate <= EffectiveEnd,
        1,
        0
    )
